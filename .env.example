# ─────────────────────────────────────────────────────────────────────────────
# THE ONLY ONE YOU MUST SET
# ─────────────────────────────────────────────────────────────────────────────

# From @BotFather on Telegram: /newbot, then copy the token it gives you.
BOT_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
# THE BOT WORKS THESE OUT ITSELF — set them only if you want to
#
#   Owner   → send /claim to the bot and you become it
#   Channel → add the bot to your channel as an admin and it notices
#   Logo    → send the bot the image as a FILE, in chat
#
# All three are remembered in the data volume, so they survive restarts.
# ─────────────────────────────────────────────────────────────────────────────

# Numeric Telegram user ids allowed to post, comma separated. Leave empty and
# the first person to send /claim becomes the owner.
ADMIN_IDS=

# @publicname, or the numeric -100… id for a private channel. Setting this
# pins one permanent destination. Leave it empty and the bot simply posts
# everywhere its owner has added it — channels and groups alike.
CHANNEL_ID=

# An unclaimed bot can only be claimed within this many minutes of starting,
# and only while it has no owner at all. Set ALLOW_CLAIM=false to require
# ADMIN_IDS instead.
ALLOW_CLAIM=true
CLAIM_WINDOW_MIN=60

# ─────────────────────────────────────────────────────────────────────────────
# WATERMARK
# ─────────────────────────────────────────────────────────────────────────────

# none  — post untouched
# text  — WATERMARK_TEXT in a corner
# logo  — WATERMARK_LOGO image in a corner
# both  — logo in one corner, text in the opposite one
# tiled — text repeated across the whole frame (hardest to crop out)
WATERMARK_MODE=text

# Used by text / both / tiled.
WATERMARK_TEXT=@yourchannel

# Used by logo / both. A transparent PNG works best.
WATERMARK_LOGO=assets/watermark.png

# tl · tr · bl · br · center
WATERMARK_POSITION=br

# 0 = invisible, 1 = solid.
WATERMARK_OPACITY=0.75

# Logo width as a fraction of the video width (0.18 = 18%).
WATERMARK_SCALE=0.18

# Text size as a fraction of the SHORTER side.
WATERMARK_TEXT_SCALE=0.045

# Gap from the edge, as a fraction of the video width.
WATERMARK_MARGIN=0.03

# Grid size for WATERMARK_MODE=tiled.
WATERMARK_TILE_ROWS=3
WATERMARK_TILE_COLS=3

# Any .ttf on the machine. The Docker image ships DejaVu at this path.
WATERMARK_FONT=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf

# If your logo PNG has no transparency and sits on a solid background, put that
# colour here to knock it out — otherwise it lands on the video as a solid box.
# Example for a logo on black:
# WATERMARK_CHROMA_KEY=0x000000

# ─────────────────────────────────────────────────────────────────────────────
# COVERING AN EXISTING WATERMARK
#
# Looks for a burned-in watermark from the original uploader (TikTok handle,
# an @username, a channel bug) and hides it: blurs the patch, then stamps your
# logo on top.
#
# HOW IT FINDS IT: a watermark is the part of the frame that never changes while
# everything else does — and that has detail, unlike a patch of empty sky. It
# also has to be small and near an edge.
#
# ⚠️ IT IS A GUESS, AND IT IS NOT CONFIRMED WITH YOU BEFORE POSTING. It will
# sometimes miss one, and it can occasionally blur something that was part of
# the video. Every post that gets covered says so in the confirmation message,
# so check that line. Set COVER_EXISTING=false to turn it off entirely.
#
# Video only — a single photo gives nothing to compare frames against.
# ─────────────────────────────────────────────────────────────────────────────

COVER_EXISTING=true

# Stamp your logo over the blurred patch as well. Falls back to blur-only if
# the logo file is missing.
COVER_WITH_LOGO=true

# Blur radius as a share of the patch size. Higher = mushier, harder to read.
COVER_BLUR=0.16

# ─────────────────────────────────────────────────────────────────────────────
# CAPTION
# ─────────────────────────────────────────────────────────────────────────────

# original — reuse the Instagram caption
# none     — post with no caption
CAPTION_MODE=original

# Appended after the caption. {uploader} and {url} are filled in.
# Use \n for a line break.
CAPTION_SUFFIX=

# Telegram's own hard cap is 1024. Set 0 to always post with no caption.
CAPTION_MAX_LENGTH=1024

# ─────────────────────────────────────────────────────────────────────────────
# RUNNING
# ─────────────────────────────────────────────────────────────────────────────

# polling — the bot calls Telegram. Needs no public URL. Use this on a VM,
#           a spare machine, or anywhere always-on.
# webhook — Telegram calls the bot. Needs a public https URL. Use this on
#           Cloud Run / Render / anything that sleeps when idle.
MODE=polling

# webhook mode only: the public https base URL of this service.
WEBHOOK_URL=
# webhook mode: optional shared secret Telegram echoes back on every request.
WEBHOOK_SECRET=

PORT=8080

# Running on Cloud Run (or any platform that freezes the CPU once a response
# is sent and bills per request)? Set this. Each job then runs inside a
# self-addressed /work request that stays open for the job's duration, which
# is what keeps the CPU allocated. Implies webhook mode. Give the service
# --max-instances 1 and a request timeout of ~1800s, and mount persistent
# storage at the data dir or the owner claim, destinations and logo will
# vanish every time the service scales to zero.
SERVERLESS=false

# Where downloads are staged before posting. Give it a directory of its OWN —
# the bot clears out abandoned files here when disk runs short, and while it
# only ever deletes directories it created itself, a dedicated path leaves no
# room for doubt. Inside Docker this is container-local and already correct.
# TMP_DIR=/tmp/insta-repost

# Only if you run your own tdlib/telegram-bot-api server. That raises the
# upload ceiling from 50MB to 2GB. Leave empty to use Telegram's own API.
# TELEGRAM_API_ROOT=

# ─────────────────────────────────────────────────────────────────────────────
# DOWNLOADING
# ─────────────────────────────────────────────────────────────────────────────

# Skip anything bigger than this. Telegram will not accept an upload over 50MB
# no matter what you put here.
MAX_FILESIZE_MB=48
UPLOAD_LIMIT_MB=50

# Optional. Instagram gets much more permissive when requests are authenticated.
# Export cookies.txt from a browser logged into a BURNER account and point here.
# COOKIES_FILE=/app/cookies/instagram.txt

# Try gallery-dl when yt-dlp fails. They are independent scrapers and rarely
# break on the same day.
FALLBACK_GALLERYDL=true

# Keep yt-dlp up to date by itself — at boot and then on a timer.
#
# This is THE setting that decides whether the bot needs looking after.
# Instagram changes its site every few weeks and breaks the downloader for
# everyone; yt-dlp ships a fix within days, but a container that never updates
# stays broken until someone rebuilds it. Leave this on.
YTDLP_AUTO_UPDATE=true
YTDLP_UPDATE_INTERVAL_HOURS=24

# Also update WHEN A DOWNLOAD FAILS, then retry once (at most once per 6h).
# On serverless this is the only update that helps, because anything written
# to disk at boot evaporates at scale-to-zero.
YTDLP_UPDATE_ON_FAILURE=true

# How it updates. NOT `yt-dlp -U` — that refuses to touch a pip install, which
# is how the image installs it. Only change this if you installed yt-dlp some
# other way.
# YTDLP_UPDATE_CMD=pip3 install --user --upgrade --no-cache-dir --break-system-packages yt-dlp[default,curl-cffi]

# Refuse to start a download below this much free disk, after first clearing
# out anything left behind by a job that was killed mid-encode.
MIN_FREE_SPACE_MB=500

# Message the admins on Telegram if the bot starts up with a problem — it can't
# see the channel, ffmpeg is missing, the disk is nearly full. On a machine
# nobody logs into, a warning in the log is a warning nobody reads.
ALERT_ADMINS_ON_BOOT=true

# Extra yt-dlp flags, space separated. Rarely needed.
YTDLP_EXTRA_ARGS=

DOWNLOAD_TIMEOUT_SEC=180
ENCODE_TIMEOUT_SEC=600
QUEUE_LIMIT=20

# error · warn · info · debug
LOG_LEVEL=info
